{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strict": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "baseUrl": ".",
    "paths": {
      "@navigation/*": ["./navigation/*"],
      "@features/*": ["./features/*"],
      "@assets/*": ["./assets/*"],
      "@utils/*": ["./utils/*"],
      "@store/*": ["./store/*"],
      "@hooks/*": ["./hooks/*"],
      "@templates/*": ["./templates/*"],
      "@atoms/*": ["./atoms/*"],
      "@local-database/*": ["./local-database/*"]
    }
  },
  "exclude": [
    "./dist",
    "node_modules"
  ],
  "include": [
    "./**/*.ts",
    "./**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
