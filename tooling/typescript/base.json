{
  "compilerOptions": {
    "strict": true,
    "strictNullChecks": true,
    "esModuleInterop": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "noUnusedLocals": true,
    "incremental": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "jsx": "react",
    "moduleResolution": "NodeNext",
    "module": "NodeNext",
    "declaration": true
  },
  "exclude": ["node_modules", "dist"]
}
