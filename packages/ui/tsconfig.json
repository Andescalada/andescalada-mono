{
  "extends":"@andescalada/tsconfig/react-native-base",
  "compilerOptions": {
    "baseUrl": ".",
    "rootDir": ".",
    "outDir": "dist",
    "composite": true,
    "tsBuildInfoFile": "./dist/tsbuildinfo",
    "paths": {
      "@andescalada/icons/*": ["../icons/src/*"],
      "Box": ["./src/Box"],
      "TextInput/TextInput": ["./src/TextInput/TextInput"],
      "Pressable/Pressable": ["./src/Pressable/Pressable"],
      "Theme/config": ["./src/Theme/config"],
      "Theme/createVariants": ["./src/Theme/createVariants"],
      "index": ["./src/index"]
    }
  },
  "include": ["src/**/*"],
  "references": [
    { "path": "../icons" }
  ]
}
